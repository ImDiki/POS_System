<Window x:Class="OICPOSレジ_2C29KS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OIC POS SYSTEM" Height="650" Width="1100" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" Background="#F4F7F6">

            <TextBlock x:Name="WelcomeText" Text="いらっしゃいませー" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="50" Foreground="LightGray"/>

            <ContentControl x:Name="MainContentArea" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Button x:Name="OpenSidebarBtn" Content="☰" FontSize="28" FontWeight="Bold" 
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15" 
                    Width="50" Height="50" Background="Transparent" BorderThickness="0" 
                    Cursor="Hand" Click="OpenSidebar_Click" Visibility="Collapsed" Panel.ZIndex="10"/>

            <Border x:Name="LoginViewPanel" Background="White" BorderBrush="CadetBlue" BorderThickness="3" 
                    Width="400" Height="250" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Visibility="Collapsed" CornerRadius="5" Panel.ZIndex="20">
                <StackPanel VerticalAlignment="Center" Margin="20">
                    <TextBlock Text="社員番号 (Staff ID)" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>
                    <TextBox x:Name="StaffIdTextBox" FontSize="36" Height="60" Width="250" 
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                             KeyDown="StaffIdTextBox_KeyDown"/>
                    <TextBlock Text="入力後、Enterキーを押してください" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="SidebarPanel" Grid.Column="0" Background="CadetBlue" Width="280">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,20,20,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OIC POS" Foreground="White" FontSize="28" FontWeight="Heavy"/>
                        <TextBlock x:Name="DateTimeText" Text="Loading time..." Foreground="#E0E0E0" FontSize="14" Margin="0,5,0,0"/>
                        <TextBlock x:Name="UserText" Text="担当：未ログイン" Foreground="#FFD700" FontSize="15" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Width="35" Height="35" Background="Transparent" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" Click="CloseSidebar_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="20,0,20,0">
                    <Button x:Name="CheckoutBtn" Content="会計" Background="#E74C3C" Foreground="White" FontSize="24" FontWeight="Bold" 
                            Height="70" Margin="0,0,0,20" BorderThickness="3" Cursor="Hand" Click="CheckoutBtn_Click"/>

                    <Button x:Name="HistoryBtn" Content="履歴" Background="#3498DB" Foreground="White" FontSize="24" FontWeight="Bold" 
                            Height="70" Margin="0,0,0,20" BorderThickness="3" Cursor="Hand" Click="HistoryBtn_Click"/>

                    <Button x:Name="ProductBtn" Content="商品管理" Background="#9B59B6" Foreground="White" FontSize="24" FontWeight="Bold" 
                            Height="70" Margin="0,0,0,20" BorderThickness="3" Cursor="Hand" Click="ProductBtn_Click"/>

                    <Button x:Name="LoginBtn" Content="ログイン" Background="#2C3E50" Foreground="White" FontSize="24" FontWeight="Bold" 
                            Height="70" Margin="0,0,0,20" BorderThickness="3" Cursor="Hand" Click="LoginBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>