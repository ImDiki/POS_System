<Window x:Class="OICPOSレジ_2C29KS.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="領収書 (Receipt)" Height="520" Width="340" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FFFDF9"
        WindowStyle="None" BorderBrush="#2C3E50" BorderThickness="1">

    <Border BorderBrush="LightGray" BorderThickness="1" Margin="15" Padding="15" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="OIC CONVENIENCE STORE" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="大阪情報コンピュータ専門学校" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,10"/>

                <TextBlock x:Name="ReceiptNoText" Text="レシートNo: 000000" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <TextBlock Text="----------------------------------------" Foreground="Gray" HorizontalAlignment="Center"/>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ReceiptTimeText" Grid.Column="0" Text="2026/05/24 12:00:00" FontSize="12" Foreground="#555"/>
                    <TextBlock x:Name="StaffNameText" Grid.Column="1" Text="担当: ----" FontSize="12" Foreground="#555" HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock Text="----------------------------------------" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="※ 商品明細 (Items)" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>

                    <ItemsControl x:Name="ReceiptItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='¥{0:N0}'}" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="----------------------------------------" Foreground="Gray" HorizontalAlignment="Center"/>

                <Grid Margin="5,8,5,5">
                    <TextBlock Text="合計 (TOTAL)" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTotal" Text="¥0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="5,2">
                    <TextBlock x:Name="PaymentMethodText" Text="お預かり (CASH)" FontSize="13" Foreground="#555"/>
                    <TextBlock x:Name="TxtPaid" Text="¥0" FontSize="13" Foreground="#555" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="5,5">
                    <TextBlock Text="お釣り (CHANGE)" FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtChange" Text="¥0" FontSize="16" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock Text="----------------------------------------" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,15,0,0">
                <TextBlock Text="お買い上げありがとうございました！" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="またのご来店をお待ちしております" FontSize="11" Foreground="#777" HorizontalAlignment="Center" Margin="0,2,0,15"/>

                <Button Content="閉じる (Close)" Width="120" Height="35" Background="#34495E" Foreground="White" 
                        FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>

</Window>