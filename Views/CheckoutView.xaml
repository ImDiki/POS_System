<UserControl x:Class="OICPOSレジ_2C29KS.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7F6"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid>
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5.5*"/>
                    <RowDefinition Height="4.5*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="購入リスト" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="バーコード入力:" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="BarcodeTextBox" Grid.Column="1" FontSize="16" Height="35" VerticalContentAlignment="Center" KeyDown="BarcodeTextBox_KeyDown"/>
                        </Grid>
                        <DataGrid x:Name="CartDataGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="商品名" Width="2*" Binding="{Binding ProductName}"/>
                                <DataGridTextColumn Header="単価" Width="*" Binding="{Binding Price}"/>
                                <DataGridTextColumn Header="数量" Width="*" Binding="{Binding Quantity}"/>
                                <DataGridTextColumn Header="小計" Width="*" Binding="{Binding Subtotal}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="#2C3E50" CornerRadius="8" Padding="15" Height="283" VerticalAlignment="Bottom">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" x:Name="DefaultStatusPanel" Margin="20">
                            <Button x:Name="UnlockStatusBtn" Content="ドロア内金銭" Background="red" Foreground="White" FontSize="24" FontWeight="Bold" Height="40" Margin="0,0,0,20" Cursor="Hand" Click="UnlockStatusBtn_Click"/>
                            <Button x:Name="PrintReceiptBtn" Content=" 領収書" Background="#27AE60" Foreground="White" FontSize="24" FontWeight="Bold" Height="40" Cursor="Hand" Click="PrintReceiptBtn_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="StatusDataPanel" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="DrawerTotalText" Text="ドロア合計: ¥0" Foreground="#F1C40F" FontSize="22" FontWeight="Heavy" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                            <Grid Margin="5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Bill10000Text" Text="¥10000 (5枚)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="両替" Grid.Column="1" Tag="10000" Background="#F1C40F" Foreground="Black" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnExchange_Click"/>
                                        <Button Content="補充" Grid.Column="2" Tag="10000" Background="#2ECC71" Foreground="White" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnFill_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Bill5000Text" Text="¥5000 (10枚)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="両替" Grid.Column="1" Tag="5000" Background="#F1C40F" Foreground="Black" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnExchange_Click"/>
                                        <Button Content="補充" Grid.Column="2" Tag="5000" Background="#2ECC71" Foreground="White" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnFill_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Bill1000Text" Text="¥1000 (20枚)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="両替" Grid.Column="1" Tag="1000" Background="#F1C40F" Foreground="Black" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnExchange_Click"/>
                                        <Button Content="補充" Grid.Column="2" Tag="1000" Background="#2ECC71" Foreground="White" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnFill_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Coin500Text" Text="¥500 (30枚)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="両替" Grid.Column="1" Tag="500" Background="#F1C40F" Foreground="Black" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnExchange_Click"/>
                                        <Button Content="補充" Grid.Column="2" Tag="500" Background="#2ECC71" Foreground="White" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnFill_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Coin100Text" Text="¥100 (50枚)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="両替" Grid.Column="1" Tag="100" Background="#F1C40F" Foreground="Black" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnExchange_Click"/>
                                        <Button Content="補充" Grid.Column="2" Tag="100" Background="#2ECC71" Foreground="White" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnFill_Click"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Coin50Text" Text="¥50 (50枚)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="両替" Grid.Column="1" Tag="50" Background="#F1C40F" Foreground="Black" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnExchange_Click"/>
                                        <Button Content="補充" Grid.Column="2" Tag="50" Background="#2ECC71" Foreground="White" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnFill_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Coin10Text" Text="¥10 (100枚)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="両替" Grid.Column="1" Tag="10" Background="#F1C40F" Foreground="Black" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnExchange_Click"/>
                                        <Button Content="補充" Grid.Column="2" Tag="10" Background="#2ECC71" Foreground="White" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnFill_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Coin5Text" Text="¥5 (50枚)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="両替" Grid.Column="1" Tag="5" Background="#F1C40F" Foreground="Black" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnExchange_Click"/>
                                        <Button Content="補充" Grid.Column="2" Tag="5" Background="#2ECC71" Foreground="White" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnFill_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Coin1Text" Text="¥1 (100枚)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="-" Grid.Column="1" Background="Gray" Foreground="White" Margin="2,0" Padding="0,3" IsEnabled="False"/>
                                        <Button Content="補充" Grid.Column="2" Tag="1" Background="#2ECC71" Foreground="White" Margin="2,0" Padding="0,3" Cursor="Hand" Click="BtnFill_Click"/>
                                    </Grid>
                                    <Button Content="隠す" Background="#E74C3C" Foreground="White" Height="35" Margin="0,15,0,0" Cursor="Hand" Click="HideStatusBtn_Click" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="お会計" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <Border Grid.Row="1" Background="#E8F8F5" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="合計:" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TotalAmountText" Text="¥0" FontSize="24" FontWeight="Heavy" Foreground="#E74C3C" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="LightGray" Margin="0,5"/>
                            <Grid>
                                <TextBlock Text="お釣り:" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ChangeText" Text="¥0" FontSize="20" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="お預かり:" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox x:Name="CashInputBox" FontSize="28" Height="45" Text="0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                    </StackPanel>
                   
                    <UniformGrid Grid.Row="4" Columns="3" Margin="0,0,0,10">
                        <Button Content="¥10,000" FontSize="16" FontWeight="Bold" Background="#F1C40F" Foreground="Black" Height="40" Margin="2" Cursor="Hand"/>
                        <Button Content="¥5,000" FontSize="16" FontWeight="Bold" Background="#F1C40F" Foreground="Black" Height="40" Margin="2" Cursor="Hand"/>
                        <Button Content="¥1,000" FontSize="16" FontWeight="Bold" Background="#F1C40F" Foreground="Black" Height="40" Margin="2" Cursor="Hand"/>
                    </UniformGrid>
                    <UniformGrid Grid.Row="5" Columns="3" Rows="4" Margin="0,0,0,15">
                        <Button Content="7" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="8" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="9" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="4" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="5" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="6" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="1" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="2" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="3" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="0" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="00" FontSize="24" FontWeight="Bold" Background="#ECF0F1" Margin="2" Cursor="Hand"/>
                        <Button Content="C" FontSize="24" FontWeight="Bold" Background="#E74C3C" Foreground="White" Margin="2" Cursor="Hand"/>
                    </UniformGrid>
                    <Button Grid.Row="6" x:Name="PayBtn" Content="現金で精算する" Background="#3498DB" Foreground="White" FontSize="20" FontWeight="Bold" Height="55" BorderThickness="0" Cursor="Hand" Click="PayBtn_Click"/>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="SecurityPopupPanel" Background="#BB000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="White" Width="320" Height="220" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="20" VerticalAlignment="Center">
                    <TextBlock Text="🔒 セキュリティ確認" FontSize="18" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="社員番号:" FontSize="13" Foreground="Gray" Margin="0,0,0,10"/>
                    <TextBox x:Name="SecurityIdBox" FontSize="22" Height="45" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" KeyDown="SecurityIdBox_KeyDown"/>
                    <Button Content="キャンセル" Margin="0,20,0,0" Height="35" Background="#95A5A6" Foreground="White" Cursor="Hand" Click="CancelSecurity_Click"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>