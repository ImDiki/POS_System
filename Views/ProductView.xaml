<UserControl x:Class="OICPOSレジ_2C29KS.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="商品登録 (Product Registration)" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="JANコード:" FontSize="14"/>
            <TextBox x:Name="TxtCode" Height="40" Margin="0,5,0,15" FontSize="16" VerticalContentAlignment="Center"/>

            <TextBlock Text="商品名:" FontSize="14"/>
            <TextBox x:Name="TxtName" Height="40" Margin="0,5,0,15" FontSize="16" VerticalContentAlignment="Center"/>

            <TextBlock Text="単価 (Price):" FontSize="14"/>
            <TextBox x:Name="TxtPrice" Height="40" Margin="0,5,0,25" FontSize="16" VerticalContentAlignment="Center"/>

            <TextBlock Text="仕入れ単価 (Cost):" FontSize="14"/>
            <TextBox x:Name="TxtCost" Height="40" Margin="0,5,0,15" FontSize="16" VerticalContentAlignment="Center"/>

            <TextBlock Text="在庫数 (Stock):" FontSize="14"/>
            <TextBox x:Name="TxtStock" Height="40" Margin="0,5,0,25" FontSize="16" VerticalContentAlignment="Center"/>

            <Button Content="保存" Background="#27AE60" Foreground="White" Height="50" FontSize="18" FontWeight="Bold" Cursor="Hand" Click="SaveProduct_Click"/>
        </StackPanel>

        <DataGrid Grid.Column="1" x:Name="ProductDataGrid" AutoGenerateColumns="True" CanUserAddRows="False" Background="#F9F9F9" FontSize="14" HeadersVisibility="Column"/>
    </Grid>
</UserControl>